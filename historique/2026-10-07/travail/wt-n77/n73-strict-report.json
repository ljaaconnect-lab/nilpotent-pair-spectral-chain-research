  "exact_source_statements": {
    "occupation_eq_iff_bijective": "(f : Fin n \u2192 Fin n) :\n    occupation f = subsetExponent Finset.univ \u2194 Function.Bijective f",
    "expanded_linear_product": "(b : Nat \u2192 Fin n \u2192 R) :\n    (\u220f i : Fin n, linearForm (b i.val)) =\n      \u2211 f : Fin n \u2192 Fin n,\n        monomial (occupation f) (\u220f i : Fin n, b i.val (f i))",
    "sum_bijective_functions": "(w : (Fin n \u2192 Fin n) \u2192 R) :\n    (\u2211 f : Fin n \u2192 Fin n, if Function.Bijective f then w f else 0) =\n      \u2211 \u03c3 : Equiv.Perm (Fin n), w \u03c3",
    "full_coefficient_permutation": "(b : Nat \u2192 Fin n \u2192 R) :\n    (\u220f i : Fin n, linearForm (b i.val)).coeff (subsetExponent Finset.univ) =\n      \u2211 \u03c3 : Equiv.Perm (Fin n), \u220f i : Fin n, b i.val (\u03c3 i)",
    "subsetExponent_apply": "(U : Finset (Fin n)) (j : Fin n) :\n    subsetExponent U j = if j \u2208 U then 1 else 0",
    "subsetExponent_support": "(U : Finset (Fin n)) :\n    (subsetExponent U).support = U",
    "subsetExponent_zero_iff": "(U : Finset (Fin n)) :\n    subsetExponent U = 0 \u2194 U = \u2205",
    "subsetExponent_erase": "(U : Finset (Fin n)) (j : Fin n) :\n    subsetExponent U - Finsupp.single j 1 = subsetExponent (U.erase j)",
    "coefficient_step": "(c : Fin n \u2192 R) (p : MvPolynomial (Fin n) R)\n    (U : Finset (Fin n)) :\n    (linearForm c * p).coeff (subsetExponent U) =\n      \u2211 j \u2208 U, c j * p.coeff (subsetExponent (U.erase j))",
    "coefficient_invariant": "(b : Nat \u2192 Fin n \u2192 R) (k : Nat)\n    (U : Finset (Fin n)) :\n    state b k U = (rowProduct b k).coeff (subsetExponent U)",
    "initial_state": "(b : Nat \u2192 Fin n \u2192 R) (U : Finset (Fin n)) :\n    state b 0 U = if U = \u2205 then 1 else 0",
    "step_state": "(b : Nat \u2192 Fin n \u2192 R) (k : Nat) (U : Finset (Fin n)) :\n    state b (k + 1) U = \u2211 j \u2208 U, b k j * state b k (U.erase j)",
    "rowProduct_eq": "(b : Nat \u2192 Fin n \u2192 R) (k : Nat) :\n    rowProduct b k = \u220f i : Fin k, linearForm (b i.val)",
    "terminal_permutation": "(b : Nat \u2192 Fin n \u2192 R) :\n    state b n Finset.univ =\n      \u2211 \u03c3 : Equiv.Perm (Fin n), \u220f i : Fin n, b i.val (\u03c3 i)",
    "terminal_matrix": "(B : Matrix (Fin n) (Fin n) R) :\n    state (matrixRows B) n Finset.univ =\n      \u2211 \u03c3 : Equiv.Perm (Fin n), \u220f i : Fin n, B i (\u03c3 i)",
    "marked_central": "(n : Nat) (hn : 2 \u2264 n)\n    (A : Matrix (Fin n) (Fin n) Rat) :\n    state (matrixRows (markedWeights A)) n Finset.univ =\n      (markedHhat A).coeff (centralDegree n)",
    "marked_target": "(A : Matrix (Fin n) (Fin n) Rat) :\n    state (matrixRows (markedWeights A)) n Finset.univ = markedPermanent A",
    "state_dimension": "(n : Nat) :\n    Fintype.card (Finset (Fin n)) = 2 ^ n"
  },
