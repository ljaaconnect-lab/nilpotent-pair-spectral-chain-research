  "exact_declaration_statements": {
    "centralDegree_pos": "(n : Nat) (hn : 2 \u2264 n) : 0 < centralDegree n",
    "padding_coefficient": "(K : Nat) (hK : 0 < K) (p : Polynomial R) :\n    (1 + Polynomial.X ^ (2 * K) + p).coeff K = p.coeff K",
    "marked_weight_eq": "{n : Nat} (A : Matrix (Fin n) (Fin n) Rat)\n    (\u03c3 : Equiv.Perm (Fin n)) :\n    weight (markedWeights A) \u03c3 = Polynomial.C (\u220f i, amplitude A i (\u03c3 i)) *\n      Polynomial.X ^ (\u2211 i, address i (\u03c3 i))",
    "padded_determinant_coefficient": "(n : Nat) (hn : 2 \u2264 n)\n    (b : Matrix (Fin n) (Fin n) R) :\n    (1 + Polynomial.X ^ (2 * centralDegree n) +\n      (forwardMatrix b (baseLabels n)).det *\n        (reverseMatrix (R := R) (baseLabels n) (baseCaps n)).det).coeff (centralDegree n) =\n      \u2211 \u03c3 : Equiv.Perm (Fin n), weight b \u03c3",
    "reverse_factor": "(n : Nat) :\n    (reverseMatrix (R := R) (baseLabels n) (baseCaps n)).det = pairFactor n",
    "hhat_central_coefficient": "(n : Nat) (hn : 2 \u2264 n)\n    (b : Matrix (Fin n) (Fin n) R) :\n    (Hhat n b).coeff (centralDegree n) =\n      \u2211 \u03c3 : Equiv.Perm (Fin n), weight b \u03c3",
    "marked_A_central_identity": "(n : Nat) (hn : 2 \u2264 n)\n    (A : Matrix (Fin n) (Fin n) Rat) :\n    (markedHhat A).coeff (centralDegree n) = markedPermanent A"
  },
