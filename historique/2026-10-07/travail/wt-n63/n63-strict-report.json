  "exact_declaration_statements": {
    "coefficient_def": "(f : Finset \u03b1 \u2192 Int) (S : Finset \u03b1) :\n    coefficient f S = \u2211 T \u2208 S.powerset, (-1 : Int) ^ (S.card - T.card) * f T",
    "coefficient_insert": "(f : Finset \u03b1 \u2192 Int) (S : Finset \u03b1) (a : \u03b1) (ha : a \u2209 S) :\n    coefficient f (insert a S) =\n      coefficient (fun T => f (insert a T)) S - coefficient f S",
    "zeta_reconstruction": "(f : Finset \u03b1 \u2192 Int) (S : Finset \u03b1) :\n    (\u2211 T \u2208 S.powerset, coefficient f T) = f S",
    "coefficient_abs_bound": "(f : Finset \u03b1 \u2192 Int) (S : Finset \u03b1)\n    (h_f : \u2200 T : Finset \u03b1, T \u2286 S \u2192 |f T| \u2264 1) :\n    |coefficient f S| \u2264 (2 : Int) ^ S.card",
    "coefficient_natAbs_bound": "(f : Finset \u03b1 \u2192 Int) (S : Finset \u03b1) (n : Nat)\n    (h_f : \u2200 T : Finset \u03b1, T \u2286 S \u2192 |f T| \u2264 1) (hcard : S.card \u2264 n) :\n    (coefficient f S).natAbs < (2 : Nat) ^ (n + 1)",
    "sign_coefficient_natAbs_bound": "(q : Finset \u03b1 \u2192 Nat) (S : Finset \u03b1) (n : Nat)\n    (hcard : S.card \u2264 n) :\n    (coefficient (fun T => (-1 : Int) ^ (q T)) S).natAbs < (2 : Nat) ^ (n + 1)"
  },
